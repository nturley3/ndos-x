+#ifdef NDOS_X_HOST
+// Append the controller side of the mouse state to the Mouse ZIP entry. The
+// upstream Keyboard entry already contains the scan buffer and pending event.
+void KEYBOARD_SaveAuxState(std::ostream& stream) {
+    writePOD(stream, uint8_t{1});
+    writePOD(stream, keyb.ps2mouse);
+    writePOD(stream, keyb.aux_command);
+    writePOD(stream, keyb.auxactive);
+    writePOD(stream, keyb.cb_irq12);
+    writePOD(stream, keyb.auxchanged);
+}
+
+void KEYBOARD_LoadAuxState(std::istream& stream, bool bios_callback_active) {
+    if (!stream) return;
+    uint8_t version = 0;
+    readPOD(stream, version);
+    if (stream.eof() && stream.gcount() == 0) {
+        stream.clear();
+        // Older slots saved the enabled INT 15h callback but omitted the
+        // corresponding controller state. Restore its BIOS stream-mode path
+        // directly, without injecting command acknowledgements into port 60h.
+        if (!IS_PC98_ARCH && bios_callback_active && keyb.ps2mouse.type != MOUSE_NONE) {
+            KEYBOARD_SetAUXActive(true);
+            keyb.ps2mouse.mode = MM_STREAM;
+            keyb.ps2mouse.reporting = true;
+            keyb.ps2mouse.int33_taken = false;
+        }
+        return;
+    }
+    if (version != 1) {
+        stream.setstate(std::ios::failbit);
+        return;
+    }
+    readPOD(stream, keyb.ps2mouse);
+    readPOD(stream, keyb.aux_command);
+    readPOD(stream, keyb.auxactive);
+    readPOD(stream, keyb.cb_irq12);
+    readPOD(stream, keyb.auxchanged);
+}
+#endif
+
+
 static void KEYBOARD_SetPort60(uint16_t val) {
     keyb.auxchanged=(val&AUX)>0;
     keyb.p60changed=true;
