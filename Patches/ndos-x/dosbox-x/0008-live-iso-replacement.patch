+namespace {
+bool ndos_x_dos_cd_name(const std::string &name) {
+    return name.size() == 16 && name.compare(0, 6, "drive_") == 0 &&
+        name[6] >= 'A' && name[6] <= 'Z' && name.compare(7, 9, "_mountimg") == 0;
+}
+bool ndos_x_ide_cd_name(const std::string &name) {
+    return name.size() == 19 && name.compare(0, 8, "IDEDrive") == 0 &&
+        name[8] >= '1' && name[8] <= '8' && (name[9] == 'm' || name[9] == 's') &&
+        name.compare(10, 9, "_mountimg") == 0;
+}
+}
+
+bool ndos_x_cd_target(const std::string &name) {
+    if (ndos_x_dos_cd_name(name))
+        return dynamic_cast<isoDrive *>(Drives[name[6] - 'A']) != nullptr;
+    return ndos_x_ide_cd_name(name) && ndos_x_ide_cd_target(name[8] - '1', name[9] == 's');
+}
+
+namespace {
+std::string ndos_x_eject_mount_target(const std::string &name) {
+    const std::string suffix = "_unmount";
+    if (name.size() < suffix.size() || name.compare(name.size() - suffix.size(), suffix.size(), suffix))
+        return {};
+    const std::string target = name.substr(0, name.size() - suffix.size()) + "_mountimg";
+    return ndos_x_cd_target(target) ? target : std::string();
+}
+
+bool ndos_x_change_cd_media(const std::string &name, const std::string &file) {
+    if (!ndos_x_cd_target(name)) return false;
+    // Console writes can re-enter the host event loop while the worker is paused.
+    struct QuietMount {
+        bool previous = qmount;
+        QuietMount() { qmount = true; }
+        ~QuietMount() { qmount = previous; }
+    } quiet;
+    IMGMOUNT imgmount(Program::prg_nopsp);
+    imgmount.cmd = new CommandLine("IMGMOUNT", "");
+    imgmount.opt_replace = true;
+    imgmount.host_silent = true;
+    if (ndos_x_dos_cd_name(name)) {
+        // Keep the original open media alive: constructors can update MSCDEX
+        // before filesystem validation. Recovery must not reopen a moved file.
+        const uint8_t subunit = MSCDEX_GetSubUnit(name[6]);
+        CDROM_Interface *previous = nullptr;
+        if (!GetMSCDEXDriveBySubUnit(subunit, &previous) || !previous) return false;
+        const bool ok = imgmount.MountIso(name[6], {file}, -1, false, false);
+        if (!ok) MSCDEX_ReplaceDrive(previous, subunit);
+        previous->Release();
+        return ok;
+    }
+    const bool ok = imgmount.MountIsoToDeviceSpec("ide", name.substr(8, 2), {file});
+    if (ok) IDE_ATAPI_MediaChangeNotify(static_cast<signed char>(name[8] - '1'), name[9] == 's', false);
+    return ok;
+}
+}
+
+bool ndos_x_replace_iso(const std::string &name, const char *path) {
+    if (!path) return false;
+    const std::string file(path);
+    if (file.size() < 4 || strcasecmp(file.c_str() + file.size() - 4, ".iso")) return false;
+    return ndos_x_change_cd_media(name, file);
+}
+
+bool ndos_x_cd_eject_target(const std::string &name) {
+    return !ndos_x_eject_mount_target(name).empty();
+}
+
+bool ndos_x_eject_cd(const std::string &name) {
+    const std::string target = ndos_x_eject_mount_target(name);
+    // Empty media keeps the CD device and its DOS association in place in both
+    // built-in DOS and booted guests. Never call the drive-removing Unmount path.
+    return !target.empty() && ndos_x_change_cd_media(target, "empty");
+}
+#endif
 
