diff --git a/include/ndos_x_menu.h b/include/ndos_x_menu.h
new file mode 100644
--- /dev/null
+++ b/include/ndos_x_menu.h
@@ -0,0 +1,21 @@
+#pragma once
+/* Worker-thread-only interface. Visitor strings are borrowed for the call. */
+#ifdef __cplusplus
+extern "C" {
+#endif
+struct ndos_x_menu_entry {
+    const char *name;
+    const char *text;
+    const char *unavailable_reason;
+    unsigned int depth;
+    int type; /* 0 action, 1 submenu, 2/3 separator */
+    int enabled;
+    int checked;
+};
+typedef void (*ndos_x_menu_visitor)(const struct ndos_x_menu_entry *, void *);
+/* 0 success, 1 not ready, 2 unavailable command. */
+int ndos_x_engine_menu_snapshot(ndos_x_menu_visitor visitor, void *context);
+int ndos_x_engine_menu_invoke(const char *name);
+#ifdef __cplusplus
+}
+#endif
