--- a/src/gui/sdl_gui.cpp
+++ b/src/gui/sdl_gui.cpp
@@ -224,6 +224,8 @@ void RebootConfig(std::string filename, bool confirm=false) {
         char LoadError[CCHMAXPATH] = {0};
         RESULTCODES result;
         DosExecPgm(LoadError, sizeof(LoadError), EXEC_ASYNC, (PSZ)para.c_str(), NULL, &result, (PSZ)exepath.c_str());
