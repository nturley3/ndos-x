+#ifdef NDOS_X_HOST
+#include "ndos_x_menu.h"
+
+// Drain each entry before closing it: minizip only checks CRC at end of entry.
+struct NDOSStateArchive {
+    unzFile file;
+    explicit NDOSStateArchive(const char *path) : file(unzOpen64(path)) {}
+    ~NDOSStateArchive() { if (file) unzClose(file); }
+
+    bool openEntry(const std::string& name) {
+        return unzLocateFile(file, name.c_str(), 1) == UNZ_OK &&
+               unzOpenCurrentFile(file) == UNZ_OK;
+    }
+    bool readEntry(const std::string& name, std::string *value = nullptr) {
+        if (!openEntry(name)) return false;
+        char buffer[16384];
+        int count;
+        while ((count = unzReadCurrentFile(file, buffer, sizeof(buffer))) > 0) {
+            if (value) {
+                if (value->size() + count > 4096) break;
+                value->append(buffer, count);
+            }
+        }
+        const bool complete = count == 0 && unzeof(file) == 1;
+        return unzCloseCurrentFile(file) == UNZ_OK && complete;
+    }
+
+    static NDOSStateResult run(NDOSStateOperation operation, const char *path) {
+        NDOSStateResult result;
+        result.currentProgram = RunningProgram;
+        SaveState& state = SaveState::instance();
+        const bool saving = operation == NDOSStateOperation::Save;
+        std::string temporary = std::string(path) + ".tmp";
+        struct Cleanup {
+            const char *path;
+            ~Cleanup() { if (path) remove(path); }
+        } cleanup{saving ? temporary.c_str() : nullptr};
+        try {
+            if (operation != NDOSStateOperation::Inspect && MEM_TotalPages() > 262144)
+                throw std::string("Save states support up to 1 GiB of guest memory.");
+            if (saving) {
+                bool compress = static_cast<Section_prop *>(control->GetSection("dosbox"))->Get_bool("compresssaveparts");
+                if (!state.writeArchive(temporary, compress, ""))
+                    throw std::string("Could not write the save state.");
+            }
+            NDOSStateArchive archive(saving ? temporary.c_str() : path);
+            if (!archive.file || !archive.readEntry("Program_Name", &result.program) ||
+                !archive.readEntry("Time_Stamp", &result.timestamp))
+                throw std::string("Could not read the save state information.");
+            if (operation == NDOSStateOperation::Inspect) return result;
+            auto check = [&](const char *key, const char *label, std::string current) {
+                std::string saved;
+                if (!archive.readEntry(key, &saved)) throw std::string("Invalid save state entry: ") + key;
+                if (!strcmp(key, "DOSBox-X_Version")) saved = saved.substr(0, saved.find('\n'));
+                if (saved != current)
+                    throw std::string(label) + " mismatch. Saved: " + saved + ". Current: " + current + ".";
+            };
+            check("DOSBox-X_Version", "Engine version", std::string("DOSBox-X ") + VERSION + " (" + SDL_STRING + ")");
+            check("Memory_Size", "Memory (4 KiB pages)", std::to_string(MEM_TotalPages()));
+            check("Machine_Type", "Machine type", getType());
+            for (auto& entry : state.components)
+                if (!archive.readEntry(entry.first)) throw std::string("Damaged or missing component: ") + entry.first;
+            if (saving) {
+                if (rename(temporary.c_str(), path)) throw std::string("Could not replace the save slot.");
+            } else {
+                for (auto& entry : state.components) {
+                    if (!archive.openEntry(entry.first)) throw std::string("Could not open component: ") + entry.first;
+                    zip_istreambuf buffer(archive.file);
+                    std::istream stream(&buffer);
+                    result.requiresRelaunch = true;
+                    entry.second.comp.setBytes(stream);
+                    if (!stream || buffer.close() != UNZ_OK)
+                        throw std::string("Could not restore component: ") + entry.first;
+                }
+                result.requiresRelaunch = false;
+            }
+        } catch (const std::string& message) {
+            result.error = message;
+        } catch (...) {
+            result.error = "The emulator could not complete the save state operation.";
+        }
+        return result;
+    }
+};
+NDOSStateResult ndos_x_engine_state(NDOSStateOperation operation, const char *path) {
+    return NDOSStateArchive::run(operation, path);
+}
+#endif
